<Project>

  <!--
    Central Package Management: a versão de cada pacote é declarada uma única vez, aqui.
  -->

  <!--
    Componentes TEC.* consumidos: versão PUBLICADA no feed tec-interno (todos os pacotes de um componente têm a mesma
    versão). No csproj use <TecReference Include="TEC.X" />, sem versão: vira PackageReference nesta versão, na máquina
    e no CI; o projeto vizinho só entra com -p:TecUseLocalProjects=true (build/Tec.Build.targets).
  -->
  <ItemGroup>
    <PackageVersion Include="TEC.Core" Version="0.0.1" />
    <PackageVersion Include="TEC.Vault" Version="0.0.1" />
    <PackageVersion Include="TEC.Vault.InMemory" Version="0.0.1" />
  </ItemGroup>

  <!-- Terceiros -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="3.7.400.185" />
    <PackageVersion Include="AWSSDK.SQS" Version="3.7.400.185" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="TUnit" Version="1.74.0" />
  </ItemGroup>

  <!-- EF Core acompanha a versão do .NET de cada runtime (EF Core 10 não suporta net8.0) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.31" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.31" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!--
    Fixações de transitivos vulneráveis (CentralPackageTransitivePinningEnabled no build/Tec.Build.props): a versão
    declarada aqui vence a que a árvore de dependências traria. Remover quando o pacote que a traz já depender da corrigida.
      System.Security.Cryptography.Pkcs: Microsoft.EntityFrameworkCore.SqlServer 10.0.12 → Microsoft.Data.SqlClient 6.1.6
      → 9.0.11, afetada por GHSA-846f-f764-76mx (CVE-2026-84008, alta) e GHSA-2fmv-rv2c-59x7 (moderada); corrigida na
      10.0.13. No net8.0 (Microsoft.Data.SqlClient 5.1.9) o pacote não entra na árvore.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
