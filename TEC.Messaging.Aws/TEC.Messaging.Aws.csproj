<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações de build, segurança e metadados comuns: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>TEC.Messaging.Aws</RootNamespace>
    <Description>Transporte AWS (SQS e SNS) do TEC.Messaging: publicação em tópicos SNS e filas SQS, consumidores com long polling, nova tentativa com espera crescente pela visibilidade da mensagem, DLQ nativa (redrive policy) e segredos integrados ao TEC.Vault.</Description>
    <PackageTags>messaging;aws;sqs;sns;cloud;retry;dead-letter;vault;opentelemetry;tec</PackageTags>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!--
      AWSSDK utiliza reflexão interna no pipeline de serialização HTTP; desativado AOT no satélite.
    -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Messaging\TEC.Messaging.csproj" />
    <TecReference Include="TEC.Vault" />
  </ItemGroup>

</Project>
