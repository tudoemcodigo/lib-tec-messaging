<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações de build, segurança e metadados comuns: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>TEC.Messaging.AzureServiceBus</RootNamespace>
    <Description>Transporte Azure Service Bus do TEC.Messaging: publicação em tópicos/filas com confirmação, consumidores com retentativa escalonada, DLQ nativa, processamento concorrente e segredos integrados ao TEC.Vault.</Description>
    <PackageTags>messaging;azure;servicebus;cloud;retry;dead-letter;vault;opentelemetry;tec</PackageTags>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!--
      Azure.Messaging.ServiceBus usa reflection interna no transporte AMQP; desativado AOT no satélite.
    -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <!--
    Satélite da família TEC.Messaging com acesso aos internos do núcleo (InternalsVisibleTo): usa os polyfills já
    compilados no TEC.Messaging; uma segunda cópia local seria o conflito CS0436.
  -->
  <ItemGroup>
    <Compile Remove="$(TecRepoRoot)build/Polyfills/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Messaging\TEC.Messaging.csproj" />
    <TecReference Include="TEC.Vault" />
  </ItemGroup>

</Project>
